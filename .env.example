# Copy this file to .env (or .env.local) for local development and fill in the values.
# On Vercel, add the same variables under Project Settings → Environment Variables.
# Never commit .env / .env.local or real credentials (both are git-ignored).

# ---------------------------------------------------------------------------
# MongoDB (server only)
# ---------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.floemj7.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB="mohan-attachakki"

# ---------------------------------------------------------------------------
# Firebase web app config (public — these identify the project, they are not secrets)
# Firebase Console → Project settings → General → Your apps → Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# Optional: Google Analytics for Firebase (leave empty to turn analytics off)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# Firebase login verification (server only)
# The server checks login tokens against Google's public keys, so only the project ID is
# needed (falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID). No service-account key is used.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Admin access (server only)
# Comma-separated list of emails allowed into /admin.
# Everyone signs up as "customer". When a listed email logs in, the server sets
# role "admin" in MongoDB. Admin APIs require BOTH role "admin" AND the email being
# listed here, so removing an email revokes access immediately.
# IMPORTANT: create these accounts yourself (Firebase Console → Authentication →
# Add user) BEFORE deploying, so nobody else can sign up with them.
# ---------------------------------------------------------------------------
ADMIN_EMAILS="khandelwal.nilay@zohomail.com"

# ---------------------------------------------------------------------------
# Local testing with the Firebase Auth Emulator (NEVER set these on Vercel)
# ---------------------------------------------------------------------------
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# ---------------------------------------------------------------------------
# Uploaded images need NO extra variable: admin uploads are stored in MongoDB (`media`
# collection, same MONGODB_URI) and served from /media/<id>.<ext>. No extra storage service needed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Public site URL (used for metadata / absolute links)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
